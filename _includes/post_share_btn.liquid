<div class="share-wrapper">
    <button
        type="button"
        class="btn btn-outline-secondary"
        id="shareBtn"
        aria-label="Share this blog"
    >
        <i class="fa-solid fa-share-nodes"></i> Share this article!
    </button>
    <span class="copied-message" id="copiedMessage">
        Copied!
    </span>
</div>

<script>
const blogTitle = `{{ include.blogTitle }}`;

const shareBtn = document.getElementById("shareBtn");
const copiedMessage = document.getElementById("copiedMessage");

shareBtn.addEventListener("click", async () => {
    const shareData = {
        title: blogTitle,
        text: `Check out this article: "${blogTitle}", by Skanda Bhairava`,
        url: window.location.href
    };

    if (navigator.share) {
        try {
            await navigator.share(shareData);
        } catch (error) {
            if (error.name !== "AbortError") {
                console.error("Share failed:", error);
            }
        }
    } else {
        try {
            await navigator.clipboard.writeText(window.location.href);

            copiedMessage.classList.remove("show");
            void copiedMessage.offsetWidth;

            copiedMessage.classList.add("show");

            setTimeout(() => {
            copiedMessage.classList.remove("show");
            }, 1800);
        } catch (error) {
            console.error("Copy failed:", error);
        }
    }
});
</script>